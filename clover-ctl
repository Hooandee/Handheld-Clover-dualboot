	[ -n "$ro" ] && steamos-readonly disable 2> /dev/null
	rm -f /etc/systemd/system/clover-bootmanager*
	rm -rf /etc/clover-dualboot
	systemctl daemon-reload 2> /dev/null
	rm -f /etc/atomic-update.conf.d/clover-whitelist.conf
	[ -n "$ro" ] && steamos-readonly enable 2> /dev/null
	rm -f "$home/.local/share/kservices5/ServiceMenus/open_as_root.desktop"
	rm -f "$home/.local/share/applications/clover-dualboot.desktop" "$home/Desktop/clover-dualboot.desktop" "$home/Desktop/Clover-Toolbox"
	rm -rf "$home/1Clover-tools"
	echo "Clover uninstalled - reboot to return to Windows."
	;;
theme-preview)
	need_root; need_efi
	name=${1:-}
	[ -n "$name" ] || die "usage: clover-ctl theme-preview <name>"
	valid_theme_name "$name"
	dir="$EFI_PATH/clover/themes/$name"
	[ -d "$dir" ] || die "theme not found: $name"
	tmp="/tmp/clover-theme-preview"
	rm -rf "$tmp"
	mkdir -p "$tmp"
	chmod 755 "$tmp"
	# background image (printed as: background<TAB>path)
	bg=$(ls "$dir" 2> /dev/null | grep -iE '\.(png|jpg|jpeg)$' | grep -i background | head -n1)
	[ -n "$bg" ] || bg=$(ls "$dir" 2> /dev/null | grep -iE 'screenshot.*\.(png|jpg|jpeg)$' | head -n1)
	[ -n "$bg" ] || bg=$(ls "$dir" 2> /dev/null | grep -iE '\.(png|jpg|jpeg)$' | head -n1)
	if [ -n "$bg" ]
	then
		cp "$dir/$bg" "$tmp/" 2> /dev/null && chmod 644 "$tmp/$bg" && printf 'background\t%s\n' "$tmp/$bg"
	fi
	# theme icons (prefer an icons/ subfolder); .icns is rendered by the app
	icondir="$dir"
	[ -d "$dir/icons" ] && icondir="$dir/icons"
	ls "$icondir" 2> /dev/null | grep -iE '^(os_|func_|vol_|tool_|pointer|selection|radio_)' | grep -iE '\.(png|icns|jpg|jpeg)$' | head -n 12 | while read -r f
	do
		cp "$icondir/$f" "$tmp/$f" 2> /dev/null && chmod 644 "$tmp/$f" && printf 'icon\t%s\n' "$tmp/$f"
	done
	;;
help|--help|-h)
	cat <<'USAGE'
clover-ctl <command> [args]
  status                                            current config + state as JSON
  maintenance-log                                  show the latest local maintenance log
  boot-layout [--mount-unmounted]                   inspect disks, EFI loaders and firmware entries as JSON
  get <resolution|theme|timeout|default-os>         read one value
  list-themes                                       installed Clover themes
  list-remote-themes                                themes available in the CloverThemes repo
  install-theme <name>                              (root) download + install a theme (max 5 on the ESP)
  remove-theme <name>                               (root) delete an installed theme (not the active one)
  detect-resolution                                 native panel resolution
  version                                           print the tool version
  set-resolution <WxH|auto>                         (root)
  set-theme <name>                                  (root)
  set-timeout <seconds>                             (root)
  set-default-os <windows|steamos|bazzite|lastos>   (root)
  set-default-loader <\EFI\path\loader.efi>          (root) use an already discovered EFI loader
  service <enable|disable>                          (root) enable Clover, or hand next boot to Windows
  protect-windows-efi                              (root) verify/refresh the Windows backup, then disable its canonical loader
  restore-windows-efi                              (root) restore Windows from its verified EFI backup
  install-clover-loader <source>                   (root) verify backup and atomically publish Clover as BOOTX64
  restore-clover-loader <source>                   (root) restore the original BOOTX64 state after verifying Clover
  repair-boot-priority [--allow-generic]           (root) register Clover and preserve the complete Clover-first BootOrder
  install-decky                                     (root) install/update the Decky (Game Mode) plugin

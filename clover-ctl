#!/bin/bash
#
# clover-ctl - non-interactive engine for the Clover dual-boot tools.
# The desktop app and the Decky plugin both call this; it does the real work
# so the logic lives in one place. Mutating commands need root (the frontends
# elevate via pkexec or Decky's root backend). Set CLOVER_CONFIG to point the
# read / config-write commands at a specific config.plist (used by the tests).

set -u

CTL_VERSION="1.1.0"

# the ESP is tiny (~25MB free), so cap how many theme folders may live on it
THEME_LIMIT=5
CLOVERTHEMES_REPO=${CLOVERTHEMES_REPO:-CloverHackyColor/CloverThemes}
CTL_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
DISCOVERY=${CLOVER_DISCOVERY:-}
if [ -z "$DISCOVERY" ]
then
	for candidate in "$CTL_DIR/boot-discovery.py" "$CTL_DIR/custom/boot-discovery.py"
	do
		[ -f "$candidate" ] && { DISCOVERY=$candidate; break; }
	done
fi
REPORTER=${CLOVER_REPORTER:-}
GENERIC_CONSENT=${CLOVER_GENERIC_CONSENT:-/etc/clover-dualboot/allow-generic}
if [ -z "$REPORTER" ]
then
	for candidate in "$CTL_DIR/support_report.py" "$CTL_DIR/custom/support_report.py"
	do
		[ -f "$candidate" ] && { REPORTER=$candidate; break; }
	done
fi

efi_directory_at_mount() {
	for candidate in "$1"/*
	do
		[ -d "$candidate" ] || continue
		[ "$(basename "$candidate" | tr '[:upper:]' '[:lower:]')" = efi ] \
			&& { printf '%s\n' "$candidate"; return 0; }
	done
	return 1
}

canonical_bootx64_path() {
	local efi_root boot_dir="" existing="" candidate
	efi_root=$1
	for candidate in "$efi_root"/*
	do
		[ -d "$candidate" ] || continue
		[ "$(basename "$candidate" | tr '[:upper:]' '[:lower:]')" = boot ] \
			&& { boot_dir=$candidate; break; }
	done
	[ -z "$boot_dir" ] || existing=$(find "$boot_dir" -mindepth 1 -maxdepth 1 -type f -iname bootx64.efi 2> /dev/null | head -n1)
	printf '%s\n' "${existing:-$efi_root/BOOT/BOOTX64.EFI}"
}

detect_os() {
	OS=unknown
	EFI_PATH=""
	WINDOWS_EFI_PATH=""
	BOOTX64=""
	if [ -n "$DISCOVERY" ] && [ -f "$DISCOVERY" ]
	then
		layout=$(python3 "$DISCOVERY" 2> /dev/null) || layout=""
		if [ -n "$layout" ]
		then
			vars=$(printf '%s' "$layout" | python3 -c '
import json, shlex, sys
d = json.load(sys.stdin)
host = d.get("host_os") or {}
target = d.get("clover_target") or {}
windows = d.get("windows") or {}
def emit(name, value): print(name + "=" + shlex.quote(str(value)))
emit("DETECTED_OS", host.get("name", "unknown"))
emit("DETECTED_TARGET_DEVICE", target.get("device", ""))
emit("DETECTED_TARGET_MOUNT", next(iter(target.get("mountpoints") or []), ""))
emit("DETECTED_WINDOWS_DEVICE", windows.get("device", ""))
emit("DETECTED_WINDOWS_MOUNT", next(iter(windows.get("mountpoints") or []), ""))
') || vars=""
			if [ -n "$vars" ]
			then
				eval "$vars"
				OS=$DETECTED_OS
				[ -z "$DETECTED_TARGET_MOUNT" ] || EFI_PATH=$(efi_directory_at_mount "$DETECTED_TARGET_MOUNT") || EFI_PATH=""
				[ -z "$EFI_PATH" ] || BOOTX64=$(canonical_bootx64_path "$EFI_PATH")
				if [ -n "$DETECTED_WINDOWS_DEVICE" ] && [ "$DETECTED_WINDOWS_DEVICE" = "$DETECTED_TARGET_DEVICE" ]
				then
					WINDOWS_EFI_PATH=$EFI_PATH
				elif [ -n "$DETECTED_WINDOWS_MOUNT" ]
				then
					WINDOWS_EFI_PATH=$(efi_directory_at_mount "$DETECTED_WINDOWS_MOUNT") || WINDOWS_EFI_PATH=""
				fi
				[ -n "$EFI_PATH" ] && return 0
			fi
		fi
	fi
	if grep -qi bazzite /etc/os-release 2> /dev/null
	then
		OS=bazzite; EFI_PATH=/boot/efi/EFI; BOOTX64=$EFI_PATH/BOOT/BOOTX64.EFI
	elif grep -qi steamos /etc/os-release 2> /dev/null
	then
		OS=SteamOS; EFI_PATH=/esp/efi; BOOTX64=$EFI_PATH/boot/bootx64.efi
	else
		OS=unknown; EFI_PATH=; BOOTX64=
	fi
	WINDOWS_EFI_PATH=$EFI_PATH
}
detect_os
# CLOVER_EFI_PATH lets the tests point the theme commands at a throwaway tree
if [ -n "${CLOVER_EFI_PATH:-}" ]
then
	EFI_PATH=$CLOVER_EFI_PATH
	WINDOWS_EFI_PATH=${CLOVER_WINDOWS_EFI_PATH:-$EFI_PATH}
else
	WINDOWS_EFI_PATH=${CLOVER_WINDOWS_EFI_PATH:-$WINDOWS_EFI_PATH}
fi
BOOTX64=${CLOVER_BOOTX_PATH:-$BOOTX64}
CONFIG=${CLOVER_CONFIG:-${EFI_PATH:+$EFI_PATH/clover/config.plist}}
TEMP_WINDOWS_MOUNT=""
PENDING_CREATED_BOOT_ID=""
PENDING_ORIGINAL_BOOT_ORDER=""

die() { echo "clover-ctl: $1" >&2; exit 1; }
need_efi() { [ -n "$EFI_PATH" ] || die "could not resolve the mounted Clover EFI partition"; }
discover_default_volume() {
	target=$1
	loader=${2:-}
	fallback_volume() {
		if [ "${CLOVER_REQUIRE_DISCOVERY:-}" != 1 ] \
			&& { [ -n "${CLOVER_EFI_PATH:-}" ] || [ -n "${CLOVER_CONFIG:-}" ]; }
		then
			printf '%s\n' esp
			return 0
		fi
		return 1
	}
	if [ -z "$DISCOVERY" ] || [ ! -f "$DISCOVERY" ]
	then
		fallback_volume
		return $?
	fi
	if ! layout=$(python3 "$DISCOVERY" --mount-unmounted 2> /dev/null)
	then
		fallback_volume
		return $?
	fi
	volume=$(printf '%s' "$layout" | python3 -c '
import json, sys
target, loader = sys.argv[1:]
data = json.load(sys.stdin)
record = data.get("windows") if target == "windows" else data.get("linux_loader")
if not isinstance(record, dict):
    raise SystemExit(3)
if target == "linux" and str(record.get("path", "")).casefold() != loader.casefold():
    raise SystemExit(3)
value = str(record.get("partuuid", "")).upper()
if not value:
    raise SystemExit(3)
print(value)
' "$target" "$loader") || return 1
	case "$volume" in
		????????-????-????-????-????????????) printf '%s\n' "$volume" ;;
		*) return 1 ;;
	esac
}
valid_theme_name() {
	case "$1" in ''|.|..|*/*) die "invalid theme name: $1" ;; esac
	printf '%s\n' "$1" | LC_ALL=C grep -Eq '^[[:alnum:] _.-]+$' \
		|| die "invalid theme name: $1"
}
theme_count() {
	[ -n "$EFI_PATH" ] || { echo 0; return; }
	find "$EFI_PATH/clover/themes" -mindepth 1 -maxdepth 1 -type d ! -name random 2> /dev/null \
		| awk 'END { print NR + 0 }'
}
installed_theme_name() {
	[ -n "$EFI_PATH" ] || return 1
	find "$EFI_PATH/clover/themes" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; 2> /dev/null \
		| awk -v wanted="$1" 'tolower($0) == tolower(wanted) { print; exit }'
}

# root is required for the real install paths; the test suite opts out explicitly
need_root() {
	[ "${CLOVER_CTL_ALLOW_NONROOT:-}" = 1 ] && return 0
	[ "$(id -u)" = 0 ] || die "must run as root (try: sudo clover-ctl $CMD ...)"
}

release_lock() {
	[ -n "${LOCK_DIR:-}" ] || return 0
	rm -f "$LOCK_DIR/pid" 2> /dev/null
	rmdir "$LOCK_DIR" 2> /dev/null || true
	LOCK_DIR=""
}

rollback_boot_repair() {
	local rollback_order=${1:-} rollback_id=${2:-}
	[ -z "$rollback_order" ] || efibootmgr -o "$rollback_order" > /dev/null 2>&1 || true
	[ -z "$rollback_id" ] || efibootmgr -b "$rollback_id" -B > /dev/null 2>&1 || true
	PENDING_ORIGINAL_BOOT_ORDER=""
	PENDING_CREATED_BOOT_ID=""
}

cleanup_on_exit() {
	rollback_boot_repair "$PENDING_ORIGINAL_BOOT_ORDER" "$PENDING_CREATED_BOOT_ID"
	release_lock
	if [ -n "$TEMP_WINDOWS_MOUNT" ]
	then
		umount "$TEMP_WINDOWS_MOUNT" 2> /dev/null || true
		rmdir "$TEMP_WINDOWS_MOUNT" 2> /dev/null || true
		TEMP_WINDOWS_MOUNT=""
	fi
}

ensure_windows_efi_mounted() {
	[ -n "$WINDOWS_EFI_PATH" ] && [ -d "$WINDOWS_EFI_PATH" ] && return 0
	[ -n "$DISCOVERY" ] && [ -f "$DISCOVERY" ] || return 1
	layout=$(python3 "$DISCOVERY" --mount-unmounted 2> /dev/null) || return 1
	vars=$(printf '%s' "$layout" | python3 -c '
import json, shlex, sys
d = json.load(sys.stdin)
w = d.get("windows") or {}
def emit(name, value):
    print(name + "=" + shlex.quote(str(value)))
emit("WINDOWS_DEVICE_TO_MOUNT", w.get("device", ""))
emit("WINDOWS_EXISTING_MOUNT", next(iter(w.get("mountpoints") or []), ""))
') || return 1
	eval "$vars"
	if [ -n "$WINDOWS_EXISTING_MOUNT" ]
	then
		WINDOWS_EFI_PATH=$(efi_directory_at_mount "$WINDOWS_EXISTING_MOUNT") || return 1
		return 0
	fi
	case "$WINDOWS_DEVICE_TO_MOUNT" in /dev/*) ;; *) return 1 ;; esac
	if [ "${CLOVER_CTL_ALLOW_NONROOT:-}" != 1 ] && [ ! -b "$WINDOWS_DEVICE_TO_MOUNT" ]
	then
		return 1
	fi
	TEMP_WINDOWS_MOUNT=$(mktemp -d "${TMPDIR:-/tmp}/clover-windows.XXXXXX") || return 1
	if ! mount -o rw,nosuid,nodev,noexec "$WINDOWS_DEVICE_TO_MOUNT" "$TEMP_WINDOWS_MOUNT"
	then
		rmdir "$TEMP_WINDOWS_MOUNT" 2> /dev/null || true
		TEMP_WINDOWS_MOUNT=""
		return 1
	fi
	trap cleanup_on_exit EXIT
	trap 'exit 1' HUP INT TERM
	WINDOWS_EFI_PATH=$(efi_directory_at_mount "$TEMP_WINDOWS_MOUNT") || return 1
}

windows_boot_entry_id() {
	[ -n "$DISCOVERY" ] && [ -f "$DISCOVERY" ] || return 1
	layout=$(python3 "$DISCOVERY" --mount-unmounted 2> /dev/null) || return 1
	printf '%s' "$layout" | python3 -c '
import json, re, sys
d = json.load(sys.stdin)
w = d.get("windows") or {}
partuuid = str(w.get("partuuid", "")).casefold()
matches = []
for entry in (d.get("firmware") or {}).get("entries") or []:
    path = str(entry.get("device_path", ""))
    guid = re.search(r"GPT,([0-9A-Fa-f-]{36}),", path, re.IGNORECASE)
    if (guid and partuuid and guid.group(1).casefold() == partuuid
            and "\\efi\\microsoft\\boot\\bootmgfw.efi" in path.casefold()):
        matches.append(str(entry.get("id", "")))
if len(matches) != 1 or not re.fullmatch(r"[0-9A-Fa-f]{4}", matches[0]):
    raise SystemExit(1)
print(matches[0].upper())
'
}

acquire_lock() {
	wanted_lock=$1
	mkdir "$wanted_lock" 2> /dev/null || die "another Clover operation is already running (remove stale lock only after confirming no Clover process is active: $wanted_lock)"
	LOCK_DIR=$wanted_lock
	printf '%s\n' "$$" > "$LOCK_DIR/pid" || { release_lock; die "could not record the Clover operation lock"; }
	trap cleanup_on_exit EXIT
	trap 'exit 1' HUP INT TERM
}

discover_boot_layout() {
	[ -n "$DISCOVERY" ] && [ -f "$DISCOVERY" ] \
		|| die "boot discovery component not found"
	python3 "$DISCOVERY" "$@"
}

need_reporter() {
	[ -n "$REPORTER" ] && [ -f "$REPORTER" ] \
		|| die "support report component not found"
	[ -n "$DISCOVERY" ] && [ -f "$DISCOVERY" ] \
		|| die "boot discovery component not found"
}

report_user_home() {
	user=${SUDO_USER:-$(id -un 1000 2> /dev/null || echo "${USER:-deck}")}
	home=""
	if command -v getent > /dev/null 2>&1
	then
		home=$(getent passwd "$user" 2> /dev/null | cut -d: -f6)
	fi
	[ -n "$home" ] || home=${HOME:-/home/$user}
	printf '%s|%s\n' "$user" "$home"
}

layout_shell_vars() {
	python3 -c '
import json, shlex, sys
d = json.load(sys.stdin)
def emit(name, value):
    print(name + "=" + shlex.quote(str(value)))
emit("LAYOUT_SAFE", "yes" if d.get("safe_to_write") else "no")
emit("LAYOUT_DISK", (d.get("clover_target") or {}).get("disk", ""))
emit("LAYOUT_PARTITION", (d.get("clover_target") or {}).get("partition", ""))
emit("LAYOUT_CLOVER_IDS", ",".join((d.get("clover") or {}).get("entry_ids") or []))
emit("LAYOUT_CLOVER_FIRST", "yes" if (d.get("clover") or {}).get("first_in_boot_order") else "no")
emit("LAYOUT_BOOT_ORDER", ",".join((d.get("firmware") or {}).get("boot_order") or []))
emit("LAYOUT_ENTRY_IDS", ",".join(entry.get("id", "") for entry in (d.get("firmware") or {}).get("entries") or []))
emit("LAYOUT_PROBLEMS", ",".join(d.get("problems") or []))
'
}

load_boot_layout() {
	layout=$(discover_boot_layout "$@") || die "could not inspect the UEFI boot layout"
	vars=$(printf '%s' "$layout" | layout_shell_vars) \
		|| die "boot discovery returned invalid data"
	eval "$vars"
}

order_contains_all() {
	wanted=$1
	actual=$2
	old_ifs=$IFS
	IFS=,
	for entry in $wanted
	do
		case ",$actual," in *",$entry,"*) ;; *) IFS=$old_ifs; return 1 ;; esac
	done
	IFS=$old_ifs
}

clover_first_order() {
	clover_id=$1
	original=$2
	current=$3
	desired=$clover_id
	base=$original
	[ -n "$base" ] || base=$current
	old_ifs=$IFS
	IFS=,
	for entry in $base
	do
		[ "$entry" = "$clover_id" ] && continue
		desired="$desired,$entry"
	done
	for entry in $current
	do
		case ",$desired," in *",$entry,"*) ;; *) desired="$desired,$entry" ;; esac
	done
	IFS=$old_ifs
	printf '%s\n' "$desired"
}

boot_ids_from_text() {
	awk '/^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/ { id=substr($1,5,4); sub(/\*/, "", id); printf "%s%s", sep, toupper(id); sep="," } END { print "" }'
}

csv_difference() {
	new_values=$1
	old_values=$2
	difference=""
	old_ifs=$IFS
	IFS=,
	for value in $new_values
	do
		case ",$old_values," in *",$value,"*) continue ;; esac
		[ -z "$difference" ] && difference=$value || difference="$difference,$value"
	done
	IFS=$old_ifs
	printf '%s\n' "$difference"
}

repair_boot_priority() {
	need_root
	discovery_args=--mount-unmounted
	if [ "${1:-}" = --allow-generic ] || [ -f "$GENERIC_CONSENT" ]
	then
		discovery_args="$discovery_args --allow-generic"
	fi
	load_boot_layout $discovery_args
	[ "$LAYOUT_SAFE" = yes ] \
		|| die "boot layout is ambiguous or incomplete: ${LAYOUT_PROBLEMS:-unknown}"
	[ -n "$LAYOUT_DISK" ] && [ -n "$LAYOUT_PARTITION" ] \
		|| die "Clover target disk or partition is missing"
	case "$LAYOUT_CLOVER_IDS" in *,*) die "multiple Clover firmware entries found; refusing to guess" ;; esac

	original_order=$LAYOUT_BOOT_ORDER
	created_id=""
	lock=${CLOVER_OPERATION_LOCK:-/run/clover-dualboot-operation.lock}
	acquire_lock "$lock"

	if [ -z "$LAYOUT_CLOVER_IDS" ]
	then
		pre_create_ids=$LAYOUT_ENTRY_IDS
		create_output=$(efibootmgr -c -d "$LAYOUT_DISK" -p "$LAYOUT_PARTITION" \
			-L "Clover - GUI Boot Manager" -l '\EFI\clover\cloverx64.efi' 2> /dev/null) \
			|| { release_lock; die "firmware rejected the Clover boot entry"; }
		post_create_ids=$(printf '%s\n' "$create_output" | boot_ids_from_text)
		new_ids=$(csv_difference "$post_create_ids" "$pre_create_ids")
		case "$new_ids" in
			????)
				created_id=$new_ids
				PENDING_CREATED_BOOT_ID=$created_id
				PENDING_ORIGINAL_BOOT_ORDER=$original_order
				;;
			*) release_lock; die "could not identify the newly created Clover boot entry" ;;
		esac
		load_boot_layout $discovery_args
		case "$LAYOUT_CLOVER_IDS" in
			"$created_id") ;;
			*)
				rollback_boot_repair "$original_order" "$created_id"
				release_lock
				die "could not verify the newly created Clover boot entry"
				;;
		esac
	fi

	clover_id=$LAYOUT_CLOVER_IDS
	order_contains_all "$original_order" "$LAYOUT_BOOT_ORDER" || {
		rollback_boot_repair "$original_order" "$created_id"
		release_lock
		die "firmware dropped an existing boot entry while registering Clover; rolled back"
	}
	desired_order=$(clover_first_order "$clover_id" "$original_order" "$LAYOUT_BOOT_ORDER")
	if ! efibootmgr -o "$desired_order" > /dev/null 2>&1
	then
		rollback_boot_repair "$original_order" "$created_id"
		release_lock
		die "firmware rejected the complete Clover-first boot order; rolled back"
	fi
	load_boot_layout $discovery_args
	if [ "$LAYOUT_BOOT_ORDER" != "$desired_order" ] || [ "$LAYOUT_CLOVER_FIRST" != yes ]
	then
		rollback_boot_repair "$original_order" "$created_id"
		release_lock
		die "firmware did not retain the Clover-first boot order; rolled back"
	fi
	rollback_boot_repair
	release_lock
	echo "Clover boot priority repaired and verified"
}

verified_publish() {
	source_file=$1
	target_file=$2
	[ -s "$source_file" ] || return 1
	stage="$target_file.cloverctl.$$"
	rm -f "$stage"
	cp "$source_file" "$stage" && cmp -s "$source_file" "$stage" \
		&& mv -f "$stage" "$target_file" && cmp -s "$source_file" "$target_file" \
		&& return 0
	rm -f "$stage"
	return 1
}

# value of a <key> in a plist - the text on the following line, tags stripped
plist_get() {
	awk -v k="<key>$1</key>" '
		f { sub(/^[[:space:]]*<[^>]*>/, ""); sub(/<\/[^>]*>[[:space:]]*$/, ""); print; exit }
		index($0, k) { f = 1 }
	' "$2" 2> /dev/null
}

# rewrite the value line after a <key>; portable (BSD/GNU) and backslash-safe via ENVIRON
plist_set() {
	[ -f "$4" ] || return 1
	PLIST_VAL=$3 awk -v k="<key>$1</key>" -v tag="$2" '
		repl { print "\t\t<" tag ">" ENVIRON["PLIST_VAL"] "</" tag ">"; repl = 0; done = 1; next }
		{ print }
		index($0, k) { repl = 1 }
		END { if (!done) exit 2 }
	' "$4" > "$4.cloverctl.tmp" || { rm -f "$4.cloverctl.tmp"; return 1; }
	mv "$4.cloverctl.tmp" "$4"
}

plist_set_pair() {
	file=$7
	[ -f "$file" ] || return 1
	work=$(mktemp "$file.cloverctl.XXXXXX") || return 1
	cp "$file" "$work" \
		&& plist_set "$1" "$2" "$3" "$work" \
		&& plist_set "$4" "$5" "$6" "$work" \
		&& mv "$work" "$file" \
		&& return 0
	rm -f "$work" "$work.cloverctl.tmp"
	return 1
}

refresh_windows_backup() {
	source_loader=$1
	backup=$2
	previous=$3
	new_backup="$backup.new"
	new_previous="$previous.new"
	rm -f "$new_backup" "$new_previous"
	[ -s "$source_loader" ] || return 1
	cp "$source_loader" "$new_backup" && cmp -s "$source_loader" "$new_backup" \
		|| { rm -f "$new_backup"; return 1; }
	if [ -e "$backup" ]
	then
		[ -s "$backup" ] \
			&& cp "$backup" "$new_previous" \
			&& cmp -s "$backup" "$new_previous" \
			&& mv -f "$new_previous" "$previous" \
			|| { rm -f "$new_backup" "$new_previous"; return 1; }
	fi
	mv -f "$new_backup" "$backup"
}

protect_windows_efi() {
	need_root; need_efi
	ensure_windows_efi_mounted || die "could not safely mount the unique Windows EFI partition"
	win_boot="$WINDOWS_EFI_PATH/Microsoft/Boot"
	active="$win_boot/bootmgfw.efi"
	backup="$active.orig"
	previous="$active.orig.prev"
	disabled="$WINDOWS_EFI_PATH/Microsoft/bootmgfw.efi"
	[ -d "$win_boot" ] || die "Windows EFI directory not found: $win_boot"
	acquire_lock "$WINDOWS_EFI_PATH/Microsoft/.clover-efi.lock"
	if [ -e "$active" ]
	then
		refresh_windows_backup "$active" "$backup" "$previous" \
			|| die "could not create a verified Windows EFI backup - leaving Windows enabled"
		mv -f "$active" "$disabled" \
			|| die "could not disable the Windows EFI loader - leaving Windows enabled"
		if ! cmp -s "$backup" "$disabled"
		then
			verified_publish "$backup" "$active" \
				|| die "Windows EFI verification and verified rollback both failed; the backup remains at $backup"
			die "Windows EFI verification failed; the canonical loader was restored from the verified backup"
		fi
		release_lock
		echo "Windows EFI loader protected and disabled"
		return 0
	fi
	[ -s "$backup" ] && [ -s "$disabled" ] \
		|| die "Windows EFI loader or verified backup missing - refusing to continue"
	if ! cmp -s "$backup" "$disabled"
	then
		refresh_windows_backup "$disabled" "$backup" "$previous" \
			|| die "could not refresh the Windows EFI backup"
	fi
	release_lock
	echo "Windows EFI loader already disabled with a verified backup"
}

restore_windows_efi() {
	need_root; need_efi
	ensure_windows_efi_mounted || die "could not safely mount the unique Windows EFI partition"
	win_boot="$WINDOWS_EFI_PATH/Microsoft/Boot"
	active="$win_boot/bootmgfw.efi"
	backup="$active.orig"
	[ -s "$backup" ] || die "verified Windows EFI backup is missing"
	acquire_lock "$WINDOWS_EFI_PATH/Microsoft/.clover-efi.lock"
	verified_publish "$backup" "$active" \
		|| die "could not restore and verify the Windows EFI loader"
	release_lock
	echo "Windows EFI loader restored"
}

install_clover_loader() {
	need_root; need_efi
	source_loader=$1
	[ -s "$source_loader" ] || die "Clover loader not found: $source_loader"
	[ -n "$BOOTX64" ] || die "canonical BOOTX64 path is unknown"
	mkdir -p "$(dirname "$BOOTX64")" || die "could not create the BOOTX64 directory"
	acquire_lock "$EFI_PATH/.clover-efi.lock"
	backup="$BOOTX64.orig"
	no_original="$BOOTX64.clover-no-original"
	if [ ! -e "$backup" ] && [ ! -e "$no_original" ]
	then
		if [ -e "$BOOTX64" ]
		then
			[ -s "$BOOTX64" ] || die "original BOOTX64 loader is empty"
			verified_publish "$BOOTX64" "$backup" || die "could not create a verified BOOTX64 backup"
		else
			marker_stage="$no_original.$$"
			printf '%s\n' "no original BOOTX64" > "$marker_stage" \
				&& mv -f "$marker_stage" "$no_original" \
				|| { rm -f "$marker_stage"; die "could not record the missing original BOOTX64 state"; }
		fi
	fi
	[ -s "$backup" ] || [ -s "$no_original" ] \
		|| die "BOOTX64 recovery state is empty or invalid"
	verified_publish "$source_loader" "$BOOTX64" || {
		if [ -s "$backup" ]
		then
			verified_publish "$backup" "$BOOTX64" \
				|| die "Clover loader publication and verified BOOTX64 rollback both failed; backup remains at $backup"
			die "could not publish the Clover loader; original BOOTX64 was restored"
		fi
		rm -f "$BOOTX64" "$no_original"
		die "could not publish the Clover loader; the originally absent BOOTX64 state was restored"
	}
	release_lock
	echo "Clover loader installed at $BOOTX64"
}

restore_clover_loader() {
	need_root; need_efi
	source_loader=$1
	[ -n "$BOOTX64" ] || die "canonical BOOTX64 path is unknown"
	backup="$BOOTX64.orig"
	no_original="$BOOTX64.clover-no-original"
	acquire_lock "$EFI_PATH/.clover-efi.lock"
	if [ -s "$backup" ]
	then
		verified_publish "$backup" "$BOOTX64" \
			|| die "could not restore and verify the original BOOTX64 loader"
		release_lock
		echo "original BOOTX64 loader restored"
		return 0
	fi
	if [ -s "$no_original" ]
	then
		[ -s "$source_loader" ] && [ -s "$BOOTX64" ] && cmp -s "$source_loader" "$BOOTX64" \
			|| die "current BOOTX64 is not the verified Clover loader; refusing to delete it"
		rm -f "$BOOTX64" "$no_original" \
			|| die "could not restore the originally absent BOOTX64 state"
		release_lock
		echo "originally absent BOOTX64 state restored"
		return 0
	fi
	die "BOOTX64 recovery state is missing"
}

# native panel resolution from the kernel, normalized to landscape (panels are often mounted rotated)
detect_native_resolution() {
	local modes res w h
	for modes in /sys/class/drm/*eDP*/modes /sys/class/drm/*DSI*/modes /sys/class/drm/*LVDS*/modes
	do
		[ -f "$modes" ] || continue
		res=$(head -n1 "$modes" 2> /dev/null)
		case "$res" in *x*) ;; *) continue ;; esac
		w=${res%%x*}; h=${res##*x}
		case "$w$h" in *[!0-9]*) continue ;; esac
		[ "$h" -gt "$w" ] && echo "${h}x${w}" || echo "${w}x${h}"
		return 0
	done
	return 1
}

# map a DefaultLoader path + DefaultVolume to a friendly OS name (loader paths in
# config.plist are mixed/upper case, so lowercase before matching)
default_os_label() {
	local loader; loader=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
	case "$2" in *LastBootedVolume*) echo lastos; return ;; esac
	case "$loader" in
		*microsoft*) echo windows ;;
		*steamcl*) echo steamos ;;
		*fedora*|*shimx64*) echo bazzite ;;
		*limine*|*systemd-bootx64*|*cachyos*grubx64*|*refind*refind_x64*) echo cachyos ;;
		*) echo unknown ;;
	esac
}

# read every status field in a single pass: resolution|theme|timeout|loader|volume
plist_get_all() {
	awk '
		function val(s) { sub(/^[[:space:]]*<[^>]*>/, "", s); sub(/<\/[^>]*>[[:space:]]*$/, "", s); return s }
		/<key>ScreenResolution<\/key>/ { getline; r = val($0) }
		/<key>Theme<\/key>/            { getline; t = val($0) }
		/<key>Timeout<\/key>/          { getline; o = val($0) }
		/<key>DefaultLoader<\/key>/    { getline; l = val($0) }
		/<key>DefaultVolume<\/key>/    { getline; v = val($0) }
		END { print r "|" t "|" o "|" l "|" v }
	' "$1" 2> /dev/null
}

